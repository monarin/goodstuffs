#!/usr/bin/env bash
set -euo pipefail

mode=renew
principal="${SDF_KRB_PRINCIPAL:-monarin@SLAC.STANFORD.EDU}"

usage() {
  cat <<'EOF'
Usage: renew_sdf_krb [--status]

Renew this host's Kerberos ticket. Password-free renewal is attempted first;
if a fresh ticket is required, kinit prompts in the current terminal.

Options:
  --status  Show this host's ticket without changing it.
  -h, --help
            Show this help.
EOF
}

case "${1-}" in
  "") ;;
  --status) mode=status ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

hostname -f
date -Is

if [[ "$mode" == status ]]; then
  if ! klist -s; then
    echo "No valid Kerberos ticket in the default cache." >&2
    exit 1
  fi
  klist -f
  exit 0
fi

if kinit -R >/dev/null 2>&1; then
  echo "Renewed the existing Kerberos ticket without a password."
else
  echo "A fresh Kerberos ticket is required for $principal."
  kinit -r 7d "$principal"
fi
klist -f
