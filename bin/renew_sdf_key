#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
mode=renew
key="${SDF_SSH_KEY:-}"

usage() {
  cat <<'EOF'
Usage: renew_sdf_key [--status] [KEY]

Compatibility helper for host-local key preparation. When the private key is
passphrase-protected, start the persistent agent and let ssh-add prompt for its
passphrase. An unencrypted key requires no daily action. This command never
installs a public key on another host.

Options:
  --status  Verify an encrypted key is loaded without changing agent state.
  -h, --help
            Show this help.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --status)
      mode=status
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --*)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [[ -n "$key" ]]; then
        echo "Only one key may be selected." >&2
        exit 2
      fi
      key="$1"
      ;;
  esac
  shift
done

if [[ -z "$key" ]]; then
  for candidate in "${HOME}/.ssh/id_ed25519" "${HOME}/.ssh/id_rsa"; do
    if [[ -r "$candidate" && -r "${candidate}.pub" ]]; then
      key="$candidate"
      break
    fi
  done
fi

if [[ -z "$key" || ! -r "$key" || ! -r "${key}.pub" ]]; then
  echo "No readable SSH private/public key pair was found." >&2
  exit 1
fi

key_requires_agent=1
if "${SDF_SSH_KEYGEN_COMMAND:-ssh-keygen}" -y -P "" -f "$key" >/dev/null 2>&1; then
  key_requires_agent=0
fi

if [[ "$key_requires_agent" -eq 1 ]]; then
  agent_args=("$key")
  if [[ "$mode" == status ]]; then
    agent_args=(--status "$key")
  fi
  "${SSH_AGENT_START_HELPER:-${script_dir}/ssh_agent_start}" "${agent_args[@]}"

  export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ssh-agent.socket"
  unset SSH_AGENT_PID
else
  echo "SSH key is not passphrase-protected; no daily agent action is required: $key"
fi
