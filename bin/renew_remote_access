#!/usr/bin/env bash
set -uo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
mode=renew
with_nersc=0
with_ssh_agent=0

usage() {
  cat <<'EOF'
Usage: renew_remote_access [--status] [--with-ssh-agent] [--with-nersc]

Prepare this host's Kerberos ticket. On sdfiana, pass --with-ssh-agent to load
its encrypted local key and --with-nersc to renew its separate Perlmutter
credential through a printed federated-login URL.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --status) mode=status ;;
    --with-ssh-agent) with_ssh_agent=1 ;;
    --with-nersc) with_nersc=1 ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

failed=0

run_step() {
  local label="$1"
  shift
  printf '\n===== %s =====\n' "$label"
  if ! "$@"; then
    echo "FAILED: $label" >&2
    failed=1
  fi
}

if [[ "$mode" == status ]]; then
  if [[ "$with_ssh_agent" -eq 1 ]]; then
    run_step "sdfiana SSH agent" "${REMOTE_ACCESS_AGENT_HELPER:-${script_dir}/ssh_agent_start}" --status
  fi
  run_step "SDF Kerberos" "${REMOTE_ACCESS_KRB_HELPER:-${script_dir}/renew_sdf_krb}" --status
  if [[ "$with_nersc" -eq 1 ]]; then
    run_step "NERSC from $(hostname -s)" "${REMOTE_ACCESS_NERSC_HELPER:-${script_dir}/renew_nersc_key}" --status
  fi
else
  if [[ "$with_ssh_agent" -eq 1 ]]; then
    run_step "sdfiana SSH agent" "${REMOTE_ACCESS_AGENT_HELPER:-${script_dir}/ssh_agent_start}"
  fi
  run_step "SDF Kerberos" "${REMOTE_ACCESS_KRB_HELPER:-${script_dir}/renew_sdf_krb}"
  if [[ "$with_nersc" -eq 1 ]]; then
    run_step "NERSC from $(hostname -s)" "${REMOTE_ACCESS_NERSC_HELPER:-${script_dir}/renew_nersc_key}" --fedid --no-browser
  fi
fi

exit "$failed"
